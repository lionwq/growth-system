.container {
  padding: 30rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f0f23 100%);
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  background: linear-gradient(90deg, #ff6b6b, #feca57, #48dbfb);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  color: #888;
  font-size: 26rpx;
}

/* 徽章区域 */
.badge-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 25rpx;
}

.badge-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 25rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.badge-icon {
  width: 90rpx;
  height: 90rpx;
  margin: 0 auto 15rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
}

.badge-card.bravery .badge-icon {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
}

.badge-card.selfcare .badge-icon {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
}

.badge-card.active {
  border-color: rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.08);
}

.badge-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  display: block;
}

.badge-card.bravery .badge-name {
  color: #ff6b6b;
}

.badge-card.selfcare .badge-name {
  color: #4ecdc4;
}

.badge-level {
  color: #888;
  font-size: 22rpx;
  display: block;
}

/* 切换按钮 */
.tab-section {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.tab-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 15rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  border: none;
  transition: all 0.3s;
}

.tab-btn.bravery {
  background: rgba(255, 107, 107, 0.15);
  color: #ff6b6b;
}

.tab-btn.bravery.active {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.4);
}

.tab-btn.selfcare {
  background: rgba(78, 205, 196, 0.15);
  color: #4ecdc4;
}

.tab-btn.selfcare.active {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(78, 205, 196, 0.4);
}

/* 分数卡片 */
.score-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 25rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.score-header {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 15rpx;
}

.score-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.bravery .score-icon {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
}

.selfcare .score-icon {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
}

.score-title {
  font-size: 30rpx;
  font-weight: bold;
}

.bravery .score-title {
  color: #ff6b6b;
}

.selfcare .score-title {
  color: #4ecdc4;
}

.score-display {
  text-align: center;
  margin: 20rpx 0;
}

.score-main {
  font-size: 80rpx;
  font-weight: bold;
  display: inline-block;
}

.bravery .score-main {
  color: #ff6b6b;
}

.selfcare .score-main {
  color: #4ecdc4;
}

.score-total {
  font-size: 36rpx;
  color: #888;
}

.progress-bar {
  height: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 10rpx;
  overflow: hidden;
  margin: 20rpx 0;
}

.progress-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.5s;
}

.bravery .progress-fill {
  background: linear-gradient(90deg, #ff6b6b, #ff8e53);
}

.selfcare .progress-fill {
  background: linear-gradient(90deg, #4ecdc4, #44a08d);
}

/* 输入区域 */
.input-area {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 15rpx;
  padding: 20rpx;
  margin-top: 15rpx;
}

.input-row {
  display: flex;
  gap: 15rpx;
  margin-bottom: 15rpx;
}

.custom-input {
  width: 180rpx;
  background: rgba(0, 0, 0, 0.3);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 10rpx;
  padding: 18rpx;
  color: #fff;
  font-size: 28rpx;
  text-align: center;
}

.event-input {
  flex: 1;
  background: rgba(0, 0, 0, 0.3);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 10rpx;
  padding: 18rpx;
  color: #fff;
  font-size: 26rpx;
}

.btn-row {
  display: flex;
  gap: 15rpx;
}

.score-btn {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}

.score-btn.add {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #fff;
}

.score-btn.minus {
  background: rgba(255, 107, 107, 0.2);
  color: #ff6b6b;
}

/* 记录区域 */
.records-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 25rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.filter-btns {
  display: flex;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.filter-btn {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  color: #888;
  border: none;
}

.filter-btn.active {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
}

.records-list {
  max-height: 350rpx;
  overflow-y: auto;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 18rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.record-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.record-icon.gray {
  opacity: 0.5;
}

.record-item.bravery .record-icon {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
}

.record-item.selfcare .record-icon {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
}

.record-content {
  flex: 1;
}

.record-event {
  font-size: 26rpx;
  display: block;
  color: #fff;
}

.record-meta {
  font-size: 22rpx;
  color: #888;
  display: block;
}

.record-change {
  font-size: 32rpx;
  font-weight: bold;
}

.record-item.bravery .record-change {
  color: #ff6b6b;
}

.record-item.selfcare .record-change {
  color: #4ecdc4;
}

.record-change.minus {
  color: #888 !important;
}

.empty-records {
  text-align: center;
  color: #888;
  padding: 50rpx;
  font-size: 26rpx;
}

/* 等级路线 */
.roadmap-section {
  display: flex;
  gap: 20rpx;
}

.roadmap-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 25rpx;
}

.roadmap-title {
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  display: block;
}

.roadmap-title.bravery-text {
  color: #ff6b6b;
}

.roadmap-title.selfcare-text {
  color: #4ecdc4;
}

.roadmap-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.roadmap-item {
  padding: 8rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
}

.roadmap-item.current {
  background: linear-gradient(135deg, #feca57, #ff9f43);
  color: #333;
  font-weight: bold;
}

.roadmap-item.locked {
  background: rgba(255, 255, 255, 0.05);
  color: #555;
}

.roadmap-item.passed {
  background: rgba(255, 255, 255, 0.12);
  color: #aaa;
}

/* 数据管理 */
.data-section {
  margin-top: 30rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
}

.data-buttons {
  display: flex;
  gap: 20rpx;
}

.data-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 15rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.data-btn.export {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

.data-btn.import {
  background: linear-gradient(135deg, #f093fb, #f5576c);
  color: #fff;
}
